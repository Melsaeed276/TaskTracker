{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "A label that shows the number of tasks for a given mode of transport. The argument is the number of tasks for the mode of transport.",
      "isCommentAutoGenerated" : true
    },
    "%@ min" : {

    },
    "0:00" : {
      "comment" : "A countdown timer.",
      "isCommentAutoGenerated" : true
    },
    "A focus session is paused. Resume it from the Timer tab to continue, or replace it here. Stop ends it permanently." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جلسة تركيز متوقفة مؤقتاً. قم بالمتابعة من تبويب المؤقت أو استبدلها هنا. الإيقاف ينهيها نهائياً."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A focus session is paused. Resume it from the Timer tab to continue, or replace it here. Stop ends it permanently."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir odak oturumu duraklatıldı. Devam etmek için Zamanlayıcı sekmesinden sürdürün veya burada değiştirin. Durdur kalıcı olarak sonlandırır."
          }
        }
      }
    },
    "A focus session is running. Use Pause/Resume on the Timer tab to continue later. Starting here replaces it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جلسة تركيز تعمل. استخدم الإيقاف المؤقت/المتابعة في تبويب المؤقت للمتابعة لاحقاً. البدء هنا يستبدلها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A focus session is running. Use Pause/Resume on the Timer tab to continue later. Starting here replaces it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir odak oturumu çalışıyor. Daha sonra devam etmek için Zamanlayıcı sekmesinde Duraklat/Sürdür'ü kullanın. Burada başlatmak değiştirir."
          }
        }
      }
    },
